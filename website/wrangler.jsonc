{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "premiere-mcp-web",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "premiere-mcp.com", "custom_domain": true },
    { "pattern": "www.premiere-mcp.com", "custom_domain": true }
  ]
}
