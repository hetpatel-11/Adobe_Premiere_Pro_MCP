{
  "name": "adobe-premiere-pro-mcp",
  "version": "1.1.1",
  "description": "281 tools for AI-driven Adobe Premiere Pro video editing via MCP, for Codex, Claude, and other MCP clients.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "setup:mac": "bash ./scripts/install-macos.sh",
    "setup:doctor": "bash ./scripts/doctor-macos.sh",
    "setup:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-windows.ps1",
    "setup:doctor:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/doctor-windows.ps1",
    "uninstall:mac": "bash ./scripts/uninstall-macos.sh",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "adobe-premiere-pro",
    "video-editing",
    "ai-automation",
    "extendscript",
    "uxp"
  ],
  "author": "hetpatel-11",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "fs-extra": "^11.2.0",
    "node-fetch": "^3.3.2",
    "path": "^0.12.7",
    "uuid": "^10.0.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "ts-jest": "^29.1.5",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
